{
  "name": "app-watchtower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --local --ip 127.0.0.1",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "vitest run tests/unit",
    "test:integration": "npm run build && wrangler deploy --dry-run --outdir .worker-build && vitest run tests/integration",
    "db:local": "wrangler d1 migrations apply watchtower --local",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"shared/**/*.ts\" \"worker/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" \"*.jsonc\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"shared/**/*.ts\" \"worker/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" \"*.jsonc\" \".github/workflows/*.yml\""
  },
  "dependencies": {
    "jose": "6.2.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261025.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "miniflare": "5.20261019.2-beta",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
