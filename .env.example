# Reference names only; the Worker uses Wrangler bindings/secrets.
# For local API development copy .dev.vars.example to .dev.vars instead.
# Do not add a VITE_ prefix or expose credentials to the dashboard bundle.
ACCESS_ISSUER=
ACCESS_AUD=
# Each monitored app stores its own generated ingestion credential server-side:
WATCHTOWER_INGEST_TOKEN=
